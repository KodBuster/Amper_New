# Общий пример. Секреты кладите в apps/backend/.env и apps/web/.env.local — не в git.

# --- Postgres / Redis (docker-compose) ---
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa-amper
REDIS_URL=redis://localhost:6379

# --- Medusa ---
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000
JWT_SECRET=change-me-jwt
COOKIE_SECRET=change-me-cookie

# --- МойСклад (JSON API 1.2) ---
MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_API_TOKEN=
MOYSKLAD_ORGANIZATION_ID=
MOYSKLAD_STORE_ID=
MOYSKLAD_PRICE_TYPE_ID=
MOYSKLAD_WEBHOOK_SECRET=

# --- Next.js витрина ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_BACKEND_URL=http://localhost:9000
